{
  "name": "voyager",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "app:build": "node scripts/build-app.mjs",
    "desktop:build": "node scripts/build-desktop.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@capacitor/core": "^8.6.0",
    "@fontsource/orbitron": "^5.3.0",
    "lucide": "^1.67.0",
    "three": "^0.187.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "description": "Voyager: a zen walking app",
  "author": "madwind",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.madwind.voyager",
    "productName": "Voyager",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "server/**",
      "shared/**",
      "desktop-www/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Voyager"
    }
  }
}
